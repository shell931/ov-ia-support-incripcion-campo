# Copy to .env and fill in. .env is NOT committed.

# --- Mode (cloud | onprem): documents intent; each piece is picked below
MODE=cloud

# --- Database: plain Postgres connection string. Nothing else from the provider is used.
# Demo (cloud): Supabase -> Connect -> "Session pooler" connection string.
#   Create the project in the SAME region as the core (us-east-1 for the demo).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>.pooler.supabase.com:5432/postgres?sslmode=require
# On-premise / offline: `docker compose --profile local-db up` and use instead:
# DATABASE_URL=postgresql://app:<password>@postgres:5432/soporte
# POSTGRES_USER=app
# POSTGRES_PASSWORD=<password>
# POSTGRES_DB=soporte
DB_POOL_MAX=5

# --- Telephony and voice server
LIVEKIT_URL=wss://<proyecto>.livekit.cloud      # local: wss://voz.cliente.local
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
SIP_TRUNK=livekit-cloud                          # local: operador-co

# --- Speech to text
STT=deepgram                                     # local: whisper
STT_BASE_URL=                                    # local: http://whisper:8000/v1
DEEPGRAM_API_KEY=

# --- Classifier
CLASSIFIER=anthropic                             # local: openai-compat
LLM_MODEL=claude-haiku-5-5                       # local: the model served by Ollama / vLLM
ANTHROPIC_API_KEY=
LLM_BASE_URL=                                    # local only: http://llm:11434/v1

# --- Text to speech
TTS=cartesia                                     # local: piper
TTS_BASE_URL=                                    # local: http://piper:5000/v1
CARTESIA_API_KEY=
TTS_VOICE=

# --- Core
CORE_URL=http://core:8000

# --- Web (Caddy): public address and console password
# Domain pointing to the EC2 Elastic IP, e.g. consola.<domain> or 3-90-12-34.sslip.io (HTTPS is automatic).
# Leave ":80" for local development (plain HTTP).
SITE_ADDRESS=:80
CONSOLE_USER=mesa
# bcrypt hash, NOT the password. Generate with:
#   docker run --rm caddy:2.10-alpine caddy hash-password --plaintext '<password>'
# Keep the single quotes: the hash contains "$" and compose would try to expand it.
CONSOLE_PASSWORD_HASH='<bcrypt-hash>'
